# Copy to deploy/dev/.env and edit if the defaults collide with something.
#
#     cp .env.test-databases.example .env
#
# Both compose.test-databases.yaml and the per-engine
# local_test_settings.<engine>.py templates read these, so the published
# port and the Django setting cannot drift apart.
#
# Change the PORT values if you already have a server on the default, or if
# you are running two versions of the same engine at once. Change the
# VERSION values to test against a different release.
#
# The defaults track the versions docs/install/ commits to - PostgreSQL 16 and
# MySQL 8.0 in linux.rst, SQL Server 2022 in win.rst - so a plain
# `poe test-engine postgres` exercises what the project actually promises
# rather than whatever is newest. If those guides move to a different version,
# move these with them.

QATRACK_TEST_POSTGRES_VERSION=16
QATRACK_TEST_POSTGRES_PORT=5432
QATRACK_TEST_POSTGRES_USER=qatrack
QATRACK_TEST_POSTGRES_PASSWORD=qatrack-test-only

QATRACK_TEST_MYSQL_VERSION=8.0
QATRACK_TEST_MYSQL_PORT=3306
QATRACK_TEST_MYSQL_PASSWORD=qatrack-test-only

# SQL Server rejects weak SA passwords outright, so this one is not of the
# same shape as the others.
QATRACK_TEST_MSSQL_VERSION=2022-latest
QATRACK_TEST_MSSQL_PORT=1433
QATRACK_TEST_MSSQL_PASSWORD=QATrack-test-only-1
