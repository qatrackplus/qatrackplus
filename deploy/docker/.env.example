# QATrack+ Docker configuration.
#
# Copy this file to .env in this folder and edit the copy:
#
#     cp .env.example .env
#
# .env is never committed to git: it holds your passwords and site settings.
# After editing it, apply the change with `docker compose up -d`.
#
# Every setting below except the PostgreSQL ones is optional. A commented-out
# setting, or one left empty, keeps the QATrack+ default shown next to it.
# Values marked JSON must be written on a single line.
#
# "Configuring QATrack+" in the Docker installation guide
# (docs/install/docker.rst) explains these settings, and the rest of that guide
# covers setup, backups and day-to-day running. Docker hosting is supported on
# Linux only.


# PostgreSQL ####################################################################
# The database container is created with these the first time it starts.
# Changing them afterwards does not change an existing database.
POSTGRES_USER=change_me
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=qatrackplus
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432

# Tells QATrack+ to read its settings from this file. Leave it set.
USE_DOCKER=true


# Hosts #########################################################################
# The host names or IP addresses people use to reach QATrack+, comma-separated.
# e.g. ALLOWED_HOSTS=qatrack.myclinic.ca,10.0.0.5
# localhost and 127.0.0.1 are always added, for the container health checks.
# nginx answers only these hosts and drops requests for any other, before they
# reach QATrack+. With *, every host is passed on and QATrack+ checks it.
ALLOWED_HOSTS=*

# Sites with CSRF errors on login behind another proxy can list their origins,
# with the scheme. If unset, they are derived from ALLOWED_HOSTS.
# CSRF_TRUSTED_ORIGINS=https://qatrack.myclinic.ca

# The host name links in emails and reports point to. Include the port if it is
# not the standard one, e.g. qatrack.myclinic.ca:8080. Set here, it is applied
# every time QATrack+ starts (a change made in the admin's Websites page is undone).
# Unset, the first host name in ALLOWED_HOSTS is used once, while the site record
# is still Django's default, example.com.
# SITE_DOMAIN=qatrack.myclinic.ca


# Secret key ####################################################################
# Signs sessions and password-reset links. If unset, QATrack+ generates one the
# first time it starts and keeps it in the user-data-volume Docker volume (or the
# QATRACK_USER_DATA_DIR folder, below), so it survives rebuilds, and says so in
# `docker compose logs django` on each start.
# That volume is not in the nightly backup: if it is lost, or QATrack+ moves to
# another server without it, everyone is signed out and password-reset links
# already sent stop working. Setting it here keeps it with your settings.
#
# To keep the key QATrack+ generated (nobody is signed out), run in this folder:
#     printf '\nSECRET_KEY=%s\n' "$(docker compose exec -T django cat deploy/docker/user-data/secret_key.txt)" >> .env
# To make a new one instead, before the first start, run:
#     docker compose run --rm --no-deps django python -c "import secrets; print(secrets.token_urlsafe(50))"
# and put it after SECRET_KEY= below, removing the #. Avoid keys with a $ in them,
# such as Django's get_random_secret_key makes: Docker Compose reads $ in this
# file as the start of a variable and changes the key. If a key has one, put it
# in single quotes, which keeps it as it is: SECRET_KEY='...'
# Changing the key once QATrack+ is in use signs everyone out.
# SECRET_KEY=


# HTTPS #########################################################################
# Set to https to serve QATrack+ over HTTPS. nginx then listens on port 443 with
# the certificate and private key in deploy/docker/user-data/ssl, and redirects
# HTTP to HTTPS; QATrack+ marks its cookies secure.
# HTTP_OR_HTTPS=http
# File names in deploy/docker/user-data/ssl. The certificate file should hold the
# full chain (your certificate first, then any intermediates).
# NGINX_SSL_CERTIFICATE=cert.pem
# NGINX_SSL_CERTIFICATE_KEY=key.pem
# (default: true with https, false with http)
# SESSION_COOKIE_SECURE=
# (default: true with https, false with http)
# CSRF_COOKIE_SECURE=
# USE_X_FORWARDED_HOST=false


# Web server (nginx) ############################################################
# Largest upload nginx accepts, e.g. for imaged test results and attachments.
# NGINX_CLIENT_MAX_BODY_SIZE=100m
# Host names nginx answers, space-separated, if they should differ from
# ALLOWED_HOSTS. Leave unset to use ALLOWED_HOSTS. Django still checks every
# request against ALLOWED_HOSTS, so add any name set here to ALLOWED_HOSTS too,
# or that name gets a 400 Bad Request.
# NGINX_SERVER_NAME=


# Direct database access ########################################################
# PostgreSQL is not published on this server's network addresses. To let a
# database client or reporting tool on this server connect (or one elsewhere,
# through an SSH tunnel), remove the # from the next line and run
# `docker compose up -d`. Put the # back and run it again to stop. Either way
# restarts the whole site for about half a minute, as every service reads this
# file. On or off, POSTGRES_PASSWORD above is what protects the database, so
# make it a strong one. See "Connecting to the database directly" in the Docker
# installation guide.
# COMPOSE_FILE=compose.yaml:compose.db-port.yaml
#
# Where the database is then published on this server. The defaults mean this
# server only (127.0.0.1), on a port that doesn't clash with a PostgreSQL already
# installed here. Keep 127.0.0.1: 0.0.0.0 would open the clinic's database to the
# whole network. These are not POSTGRES_HOST and POSTGRES_PORT above, which say
# how QATrack+ reaches the database inside Docker.
# POSTGRES_HOST_ADDRESS=127.0.0.1
# POSTGRES_HOST_PORT=5434


# General #######################################################################
# JSON; also used as MANAGERS
# ADMINS='[["Admin Name", "admin@myclinic.ca"]]'
# The name shown at the top of each page. Set here, it is applied every time
# QATrack+ starts, like SITE_DOMAIN. Unset, a new site is named QATrack+.
# SITE_NAME=QATrack+
# Your time zone, from the tz database, e.g. Europe/Paris. QATrack+ shows dates
# and times in it, and the nightly backup runs at 4 AM in it and names its files
# in it. `docker compose logs backup` shows the zone the backups use.
# TIME_ZONE=America/Toronto
# USE_TZ=true
# LANGUAGE_CODE=en
# For troubleshooting only. Never leave on in production.
# DEBUG=false
# USE_SQL_REPORTS=false


# Sessions ######################################################################
# seconds (14 days)
# SESSION_COOKIE_AGE=1209600
# SESSION_SAVE_EVERY_REQUEST=true
# SESSION_EXPIRE_AT_BROWSER_CLOSE=false


# Email #########################################################################
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# EMAIL_FAIL_SILENTLY=true
# EMAIL_NOTIFICATION_SENDER=notifications@qatrackplus.com
# EMAIL_NOTIFICATION_SUBJECT='QATrack+ Test Status Notification'
# EMAIL_NOTIFICATION_TEMPLATE=notification_email.html
# EMAIL_NOTIFICATION_SUBJECT_TEMPLATE=notification_email_subject.txt


# QC display ####################################################################
# DEFAULT_WARNING_MESSAGE='Do not treat'
# NHIST=5
# PING_INTERVAL_S=5
# CATEGORY_FIRST_OF_GROUP_ONLY=false
# CHOOSE_UNIT_CATEGORY_DROPDOWN=false
# ORDER_UNITS_BY=number
# REVIEW_DIFF_COL=false
# REVIEW_BULK=true
# These three are JSON and replace the whole default, so give every key
# (see qatrack/settings.py for the full defaults).
# ICON_SETTINGS='{"SHOW_DUE_ICONS": true, ...}'
# TEST_STATUS_DISPLAY='{"fail": "Fail", ...}'
# TEST_STATUS_DISPLAY_SHORT='{"fail": "Fail", ...}'

# Default unit availability, in hours per day.
# DEFAULT_AVAILABLE_HOURS_SUNDAY=0
# DEFAULT_AVAILABLE_HOURS_MONDAY=8
# DEFAULT_AVAILABLE_HOURS_TUESDAY=8
# DEFAULT_AVAILABLE_HOURS_WEDNESDAY=8
# DEFAULT_AVAILABLE_HOURS_THURSDAY=8
# DEFAULT_AVAILABLE_HOURS_FRIDAY=8
# DEFAULT_AVAILABLE_HOURS_SATURDAY=0


# Accounts and sign-in ##########################################################
# AUTHENTICATION_BACKENDS=qatrack.accounts.backends.QATrackAccountBackend
#   comma-separated. For Active Directory, put
#   qatrack.accounts.backends.ActiveDirectoryGroupMembershipSSLBackend first.
# ACCOUNTS_SELF_REGISTER=false
# ACCOUNTS_PASSWORD_RESET=true
# ACCOUNT_ACTIVATION_DAYS=7
# JSON
# AUTH_ADFS='{"SERVER": "adfs.myclinic.ca", ...}'


# Active Directory / LDAP #######################################################
# e.g. ad.myclinic.ca. For ldaps, this must be the name on the directory
# server's certificate (not its IP address), or sign-in fails with "Unable to
# contact LDAP server".
# AD_DNS_NAME=
# ldap, or ldaps for SSL
# AD_LDAP_PROTOCOL=ldap
# 636 for ldaps
# AD_LDAP_PORT=389
# default: built from the three settings above
# AD_LDAP_URL=
# AD_LDAP_USER=
# AD_LDAP_PW=
# e.g. dc=myclinic,dc=ca
# AD_SEARCH_DN=
# AD_NT4_DOMAIN=
# The CA certificate for ldaps. Only needed when the directory's certificate
# comes from your organization's own certificate authority (CA); leave it unset
# for one from a public CA. A root alone works only if the directory server
# sends its intermediate certificates itself; if unsure, put the root and every
# intermediate in the one PEM file. Put it in deploy/docker/user-data/ldap/ on
# the server, then use:
#   AD_CERT_FILE=/etc/qatrack/ldap/ca.pem
# See "Signing in with Active Directory over LDAPS" in the Docker install guide.
# AD_CERT_FILE=
# AD_MIRROR_GROUPS=false
# AD_LU_ACCOUNT_NAME=sAMAccountName
# AD_LU_MAIL=mail
# AD_LU_SURNAME=sn
# AD_LU_GIVEN_NAME=givenName
# AD_LU_MEMBER_OF=memberOf
# default: the five AD_LU_ values above, comma-separated
# AD_SEARCH_FIELDS=
# CLEAN_USERNAME_STRING=
# AD_CLEAN_USERNAME_STRING=
#
# How to clean user names before they are sent to the directory. Takes
# precedence over the *_CLEAN_USERNAME_STRING settings when set. One of:
#   none, lower, strip_domain (DOMAIN\user -> user), lower_strip_domain,
#   strip_upn (user@domain -> user), lower_strip_upn
# AD_USERNAME_CLEANING=


# REST API ######################################################################
# JSON. Keys given here are merged over the QATrack+ defaults.
# REST_FRAMEWORK='{"PAGE_SIZE": 100}'


# Where QATrack+ keeps its data #################################################
# By default QATrack+ keeps its data in Docker volumes, which Docker stores in its
# own folder (usually /var/lib/docker/volumes). To keep any of them in a folder on
# the server instead, such as one your IT department already backs up, set its
# variable below to that folder. Each one is separate: set only those you need.
# Give the full path, e.g. /srv/qatrack/media. A path starting with ./ is
# relative to this folder.
#
# For a site already in use, copy the data into the folder first: set on its
# own, the variable starts QATrack+ with an empty folder, and uploaded files seem
# to be missing. "Keeping QATrack+'s data in folders on the server" in
# docs/install/docker.rst shows how, step by step.
#
# Use a separate folder for each, side by side (not one inside another), kept
# for QATrack+ alone. Docker creates a folder that is missing, and each time
# QATrack+ starts it gives everything in the media, logs and user-data folders
# to the QATrack+ user (uid 1000, group 1000). So that this never happens to
# anyone else's files, QATrack+ only uses an empty folder, which it marks with a
# .qatrackplus-data file, or one already marked, and never one holding another
# of its folders or a backup; otherwise it does not start (the site is offline
# until the setting is fixed), and says why in `docker compose logs init`.
#
# Uploaded files: attachments and test images. The nightly backup reads them
# from here, and restore-media puts them back here.
# Default: the media-volume Docker volume.
# QATRACK_MEDIA_DIR=/srv/qatrack/media
#
# The nightly backups, e.g. a second disk or a network share mounted on the
# server, so the backups are not on the same disk as QATrack+. They stay readable
# by root only. Default: ./backups, the backups folder beside this file.
# QATRACK_BACKUPS_DIR=/mnt/backups/qatrack
#
# QATrack+'s own log files (debug.log, auth.log, ...).
# Default: the logs-volume Docker volume.
# QATRACK_LOGS_DIR=/srv/qatrack/logs
#
# The secret key QATrack+ generates when SECRET_KEY is not set. Not the user-data
# folder beside this file, which holds the HTTPS certificates and the LDAPS CA
# certificate; this setting does not move those.
# Default: the user-data-volume Docker volume.
# QATRACK_USER_DATA_DIR=/srv/qatrack/user-data
#
# The database stays in the postgres-volume Docker volume; the nightly backup
# writes a copy of it to the backups folder above.


# Development only ##############################################################
# Used by compose.dev.yaml, which runs QATrack+ from your checkout: your own user
# and group ids, from `id -u` and `id -g`, so QATrack+ can write into it.
# Leave unset in production.
# QATRACK_UID=1000
# QATRACK_GID=1000
