# This is an example file, copy to ".env" and uncomment and/or change the
# values you need.
#
# By default, it will run a production setup with docker volumes for:
#   - postgres DB
#   - media storage
#   - backups storage
#   - user-data storage where secret_key.txt is persisted
#
# The values in this example file represent in general the default value if
# the variable is not specified.
#
# Note that some variables should be written as JSON. These variables are annotated
# with: `# JSON`. Ideally, use the compose.yaml or the compose.dev.yaml
# files to define multiline values for these. Or, you can define single line
# values here in `.env`.


# Docker bind mounts ######################################################
# Set paths for these variables to enable bind mounts for media, backups and
# user-data.
#
# Make sure they are read-writable by the user running in the docker containers.
# On Linux, in production, the docker user has UID=999 and GID=999 by default.
# You can override these by setting HOST_UID and HOST_GID above.
#
# In development, the UID and GID default to your user's values when you build
# the image with `just compose build`.
#
# MEDIA_DIR
# Media directory where uploads are stored
# MEDIA_DIR is mapped to /app_data/media in the django and django-q containers.
# If unset, a docker volume will be used.
#
# Whatever you point this at holds records, and it only grows: an attachment is
# part of the record of the work it belongs to, a corrected upload is stored
# beside the file it replaces rather than over it, and nothing in QATrack+ ever
# deletes one. Give it room, keep it backed up, and never run a retention or
# clean-up job over it - including anything that removes "orphaned" files, since
# a file with no row pointing at it is usually a previous version of a record.
#
# The one exception is the uploads/tmp subfolder, which holds files from forms
# that were never submitted. Nothing removes those either, so it grows:
# `manage.py check_attachments --staging` reports how much is in there. Do not
# empty it blindly - a session a user can still resume refers to its staged
# uploads for AUTOSAVE_DAYS_TO_KEEP days.
# MEDIA_DIR=(unset)
#
# BACKUPS_DIR
# Backups directory where the backup files will be stored
# BACKUPS_DIR is mapped to /backups in the backup container.
# If unset, a docker volume will be used.
# BACKUPS_DIR=(unset)
#
# USER_DATA_DIR
# User data dir used for storing secret_key.txt
# USER_DATA_DIR is mapped to /user_data in the django container.
# If unset, a docker volume will be used.
#
# user-data is only used for persisting the secret key if you do not
# provide a value for the SECRET_KEY env variable. If you set a value for
# SECRET_KEY in .env, you do not need a bind mount for user-data.
#
# SECRET_KEY can be found below in Django's variables. It's recommended you use
# it to define a secret key.
#
# USER_DATA_DIR=(unset)
################################################################################


# Docker build settings ########################################################
# Use these to override the base docker images used for building the QATrack+ image.
# Note that you must use python 3.12-based images in both cases.
# BUILDER_BASE_IMAGE=ghcr.io/astral-sh/uv:0.12-python3.12-trixie-slim
# RUNTIME_BASE_IMAGE=python:3.12-slim-trixie
#
# Set these if you need to specify user ID and group ID on Linux so that
# the docker services can write to bind mounts. Then rebuild the images.
#
# ** Important: if you change the UIDs, use `just compose build` to rebuild the
# images. **
#
# For local development, UID and GID will default to your user's current values.
# HOST_UID=999
# HOST_GID=999
################################################################################


# PostgreSQL settings ##########################################################
POSTGRES_USER=change_me
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=qatrackplus

# POSTGRES_HOST_ADDRESS
# Address postgres will bind to on the host. Defaults to the loopback
# interface at 127.0.0.1. This means that by default postgres will only be
# accessible from the host where the postgres container is running.
# To access it remotely use an SSH tunnel (more secure) or change
# POSTGRES_HOST_ADDRESS to some other value (potentially less secure).
#
# POSTGRES_HOST_ADDRESS=127.0.0.1

# POSTGRES_HOST_PORT
# The port postgres will be served on, on the host. Defaults to 5434, which
# avoids collision with postgres' default port 5432 (in case a postgres server
# might already be running).
#
# POSTGRES_HOST_PORT=5434
################################################################################


# NGINX settings ###############################################################

# NGINX_SERVER_NAME
# Represents the value passed to nginx's server_name directive
# The value is automatically derived from the value you specify for
# Django's ALLOWED_HOSTS, below.
#
# Therefore, in general, you should not need to set a value for this, but you
# may if you need to.
#
# In production, generally this is set to your server name or IP address.
#
# For development, `localhost` and `127.0.0.1` are always injected in NGINX_SERVER_NAME,
# so you need not set it to any particular value if you only want to connect from
# your local host.
#
# Refer to https://nginx.org/en/docs/http/ngx_http_core_module.html#server_name
# for more information.
#
# In general, this should match values you set in Django's ALLOWED_HOSTS, below.
# NGINX_SERVER_NAME=(unset)

# NGINX_CLIENT_MAX_BODY_SIZE
# Will affect the maximum size of uploaded files.
# NGINX_CLIENT_MAX_BODY_SIZE=100m

# **Note**: if you set QATrack+'s HTTP_OR_HTTPS setting to 'https', you will need
# to provide values for the following SSL variables for nginx to work under SSL.
# 
# SSL_DIR
# A path where certificate file and certificate key file are located.
# It will get bind mounted in the nginx container.
# SSL_DIR=./ssl
#
# NGINX_SSL_CERTIFICATE_FILE
# The file name for SSL certificate file in SSL_DIR.
# NGINX_SSL_CERTIFICATE_FILE=(unset)
#
# NGINX_SSL_CERTIFICATE_KEY_FILE
# The file name for SSL certificate key file in SSL_DIR.
# NGINX_SSL_CERTIFICATE_KEY_FILE=(unset)
################################################################################


# Django/QATrack+ settings #####################################################

# Set these variables to create an initial superuser automatically
# DJANGO_SUPERUSER_USERNAME=(unset)
# DJANGO_SUPERUSER_PASSWORD=(unset)
# DJANGO_SUPERUSER_EMAIL=(unset)

# ALLOWED_HOSTS
# Add the hostname or IP address you will use to access QATrack+ here.
# For docker deployment, localhost and 127.0.01 are always injected in
# ALLOWED_HOSTS to allow service healthchecks to function.
# ALLOWED_HOSTS is required and must be non-empty.
# You may use comma-separated values to provide multiple hosts.
# e.g. ALLOWED_HOSTS=qatrackplus.domain,127.0.0.1
ALLOWED_HOSTS=qatrackplus.domain

# SECRET_KEY
# Secret key: **change the value below to a secret unique key**.
# Backup the value of the secret key and keep it safe for future use.
#
# Define it here rather than letting the system generate one. If you leave it
# unset, a secret_key.txt is created in the user-data volume (or bind mount)
# and you will have to look the value up there to back it up.
#
# SECRET_KEY=(unset)

# ADMINS='[["Admin Name", "YOUR_EMAIL_ADDRESS_GOES_HERE"]]'
# SEND_BROKEN_LINK_EMAILS=false
# SITE_NAME
#   The name shown in the page title and the navigation bar. It is applied to
#   Django's site record on start-up, because that record - not this setting -
#   is what the pages read. Setting it is also the easiest way to label a test
#   or staging instance so nobody mistakes it for the clinical one.
#
#   Applied on every start, so this variable - not the admin - is where the
#   name lives in a docker deployment: an edit made in the Django admin is
#   undone by the next restart. Leave both this and SITE_DOMAIN unset to manage
#   the record from the admin instead.
#
# SITE_NAME='QATrack+'

# SITE_DOMAIN
#   The hostname this deployment is reached on. It is applied to Django's site
#   record on start-up, and it matters beyond display: absolute links are built
#   from it, so a scheduled report emails its recipients links containing this
#   hostname. Left unset, the first entry of ALLOWED_HOSTS is used, which is
#   right unless the public hostname differs from what Django is told to
#   accept - normal behind a reverse proxy. Django's own default is
#   "example.com", which would send every report link there.
#
#   Include the port if the deployment is not on 80 or 443, e.g.
#   qatrackplus.domain:8443.
#
# SITE_DOMAIN=(unset)
# TIME_ZONE='America/Toronto'
# USE_TZ=true
# USE_I18N=true
# LANGUAGE_CODE=en
# USE_SQL_REPORTS=false

# DEFAULT_WARNING_MESSAGE='Do not treat'
# ICON_SETTINGS ='{"SHOW_DUE_ICONS": true, ...}'  # JSON
# NHIST=5
# PING_INTERVAL_S=5
# CATEGORY_FIRST_OF_GROUP_ONLY=false
# CHOOSE_UNIT_CATEGORY_DROPDOWN=false
# ORDER_UNITS_BY=number
# REVIEW_DIFF_COL=false
# REVIEW_BULK=true
# TEST_STATUS_DISPLAY='{"no_tol": "No Tol Set", ...}'  # JSON
# TEST_STATUS_DISPLAY_SHORT='{"no_tol": "NO TOL", ...}'  # JSON

# DEFAULT_AVAILABLE_HOURS_SUNDAY=0
# DEFAULT_AVAILABLE_HOURS_MONDAY=8
# DEFAULT_AVAILABLE_HOURS_TUESDAY=8
# DEFAULT_AVAILABLE_HOURS_WEDNESDAY=8
# DEFAULT_AVAILABLE_HOURS_THURSDAY=8
# DEFAULT_AVAILABLE_HOURS_FRIDAY=8
# DEFAULT_AVAILABLE_HOURS_SATURDAY=0

# SESSION_COOKIE_AGE=1036800  # 14 days in seconds
# SESSION_SAVE_EVERY_REQUEST=true
# SESSION_EXPIRE_AT_BROWSER_CLOSE=false
# CSRF_COOKIE_NAME=csrftoken
# USE_X_FORWARDED_HOST=false
# HTTP_OR_HTTPS=http

# CSRF_TRUSTED_ORIGINS
# Required for Django 4.0+ or logins/forms behind a reverse proxy will fail
# with "CSRF verification failed". Must include the scheme (http/https).
# If left unset, it's derived from ALLOWED_HOSTS above (both schemes, "*" skipped).
# For example: CSRF_TRUSTED_ORIGINS=https://my-server,http://my-server
#
# **Set this yourself if the deployment is not on port 80 or 443.** The derived
# value is scheme + host with no port, while a browser sends an Origin header
# that includes the port - so the two never match and every login answers 403.
# Include the port in each origin:
#
#   CSRF_TRUSTED_ORIGINS=http://my-server:8080,http://127.0.0.1:8080
#
# Nothing here can work it out for you: the container does not know which host
# port it was published on.
#
# If a login is refused, the django service's log says which origin was
# rejected and why, e.g.
#
#   docker compose logs django
#   Forbidden (Origin checking failed - http://my-server:8080 does not match
#   any trusted origins.): /accounts/login/
#
# A command-line check with curl will not reproduce it unless you pass
# `-H "Origin: ..."`, because Django only applies this check when the request
# carries an Origin header - which browsers always do on a POST and curl does
# not.
# CSRF_TRUSTED_ORIGINS=(default based on ALLOWED_HOSTS)

# SESSION_COOKIE_SECURE=(default based on HTTP_OR_HTTPS)
# CSRF_COOKIE_SECURE=(default based on HTTP_OR_HTTPS)

# EMAIL_NOTIFICATION_TEMPLATE='notification_email.html'

# Use either a static subject or a customizable template
# EMAIL_NOTIFICATION_SUBJECT='QATrack+ Test Status Notification'
# EMAIL_NOTIFICATION_SUBJECT_TEMPLATE='notification_email_subject.txt'

# EMAIL_NOTIFICATION_SENDER=notifications@qatrackplus.com
# EMAIL_FAIL_SILENTLY=true
# EMAIL_HOST=''
# EMAIL_HOST_USER=''
# EMAIL_HOST_PASSWORD='your_password_here'
# EMAIL_USE_TLS=true
# EMAIL_PORT=587

# DEBUG=false
# DEBUG_TOOLBAR=false

# AUTHENTICATION_BACKENDS=qatrack.accounts.backends.QATrackAccountBackend
# ACCOUNTS_SELF_REGISTER=false
# ACCOUNTS_PASSWORD_RESET=true

# AD_DNS_NAME=''
# AD_LDAP_PORT=389 # or 636 for ldaps
# AD_LDAP_PROTOCOL=ldap  # ldap or ldaps

# AD_LDAP_USER=''
# AD_LDAP_PW=''

# AD_LU_ACCOUNT_NAME=sAMAccountName
# AD_LU_MAIL=mail
# AD_LU_SURNAME=sn
# AD_LU_GIVEN_NAME=givenName
# AD_LU_MEMBER_OF=memberOf

# AD_SEARCH_FIELDS=mail,sn,givenName,sAMAccountName,memberOf

# AD_SEARCH_DN=''
# AD_NT4_DOMAIN=''

# AD_CERT_FILE=''
# CLEAN_USERNAME_STRING=''
# AD_CLEAN_USERNAME_STRING=''

# AD_USERNAME_CLEANING
# By default, this variable is unset. If it is set, it will take precedence
# over AD_CLEAN_USERNAME_STRING.
# Valid values: 'none', 'lower', 'strip_domain', 'lower_strip_domain', 'strip_upn', 'lower_strip_upn'
# strip_domain: will strip "domain\" out of "domain\user"
# strip_upn: will strip "@domain" out of "user@domain"
#
# AD_USERNAME_CLEANING=(unset)  

# AUTH_ADFS= '{"SERVER": "some.adfs.server.com", ...}'  # JSON
################################################################################
